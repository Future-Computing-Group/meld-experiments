# HPC site configuration for the M-1 memory-delta model-family sweep.
#
# Copy this file to `site.env` (gitignored) and fill in the values for your site.
# `submit.sh` reads it to build the SLURM submission; `run_memdelta.sbatch` reads it
# for the on-cluster paths. Nothing here is site-of-origin specific; all values are
# placeholders.

# --- SLURM submission (used by submit.sh) ---
SMP_ACCOUNT=your_hpc_project        # SLURM --account / billing project
SMP_PARTITION=your_gpu_partition    # a partition with one A100-class GPU
SMP_GRES=gpu:a100:1                 # one A100-40GB is enough (Q4 serving)
SMP_TIME=03:00:00
SMP_MEM=64G
SMP_CPUS=8

# --- on-cluster paths (used by run_memdelta.sbatch) ---
SMP_REPO=/path/to/2026-MELD          # this repository, on the cluster filesystem
SMP_SCRATCH=/path/to/scratch/meld    # work root: outputs, HF cache, tmp
SMP_OLLAMA_ROOT=$SMP_SCRATCH/ollama # an Ollama install (bin/, lib/) + its model store
SMP_PY=python                       # a Python with the meld deps (MiniLM encoder + numpy)
SMP_SITE_PROFILE=                   # optional: a site env script to `source` for modules

# --- experiment knobs (override the runner defaults if you wish) ---
SMP_MODELS="qwen2.5-1.5b qwen2.5-7b qwen2.5-32b mistral-7b gemma-3-12b"
SMP_PER_LEVEL=hard:200              # HotpotQA difficulty:count
SMP_ENCODER=minilm
