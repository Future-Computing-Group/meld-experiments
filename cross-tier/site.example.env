# cross-tier/site.env — REAL host targets for the SMP cross-tier continuum run + probe.
# Copy to cross-tier/site.env (GITIGNORED) and fill in real values. Never commit site.env.
# Prefer ~/.ssh/config aliases so IPs/usernames stay out of the repo and this file.

# --- SSH targets (aliases from ~/.ssh/config) ---
HPC_SSH=my-hpc-login       # your HPC login node (key-based SSH; non-interactive)
HPC_DIR=$HOME/smp-xtier    # writable dir on the HPC node for the brain bundle
# Remote python env prep, run before the brain starts. On a SLURM/module site:
# source the site env, then module-load a python >= 3.10 that provides PyYAML.
HPC_ENV="module load python-data"   # site-specific; leave empty if python>=3.10 is already on PATH
EDGE_SSH=my-edge-node      # OPTIONAL: an edge node (may need interactive auth before SSH works)
EDGE_DIR=$HOME/smp-xtier   # writable dir on the edge node for the brain bundle
EDGE_ENV=                  # remote python env prep on the edge (empty: python>=3.10 with deps on PATH)

# --- Ports ---
BROKER_PORT=1883           # probe/run broker on the laptop's loopback (127.0.0.1)
TUN_PORT=19883             # reverse-tunnel listener port on each remote's loopback

# --- Run params ---
LAT_K=100                  # latency-phase probe count
OUT_DIR=outputs/cross-tier # where result-*.json + logs land (relative to repo root)

# --- Probe-only: a short, light HPC interactive CPU allocation for the probe sub-test ---
HPC_SINTERACTIVE="sinteractive -c 1 -m 1G -t 00:15:00"
