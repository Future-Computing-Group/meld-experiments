# Raw data, downloaded corpora, embedding caches, large artifacts
data/
**/emb_cache/
*.npy
*.npz
*.parquet
*.arrow

# HuggingFace / datasets cache
.cache/
hf_cache/

# Internal-only artifacts (operational plan, readiness reports, run/ops logs):
# infra/process/billing context that must never enter public history.
plan/
SMOKE-REPORT.md
*.log
outputs/*-status.log
*-LOG.md
OPSLOG.md

# CSC cluster run design + scripts (carry account/scratch/host/scheduler strings
# the public repo must never contain; the hygiene guard forbids those tokens).
csc/

# Regenerable smoke/run outputs (figures are produced by run_local_smoke.py;
# paper-final figures, if any, are committed deliberately, not the smoke ones).
figures/
outputs/

# Python
__pycache__/
*.pyc
.pytest_cache/
.benchmarks/
.ipynb_checkpoints/
.venv/

# Edge-testbed deployment + orchestration scripts/specs: carry shared-host aliases,
# VM IPs, and infra/process detail the public repo must never contain (mirror of the
# csc/ exclusion). The reusable, scrubbed LOGIC lives in src/smp/{sync,eval}.
5gtn/
scripts/*5gtn*
scripts/setup_vm1_orchestrator.sh
scripts/watchdog_daemon.py

# Root-level edge-testbed orchestrator + run scripts (host IPs/SSH; internal infra)
5gtn-npubsub
val_c_run.sh

# Internal experiment-protocol doc (dev-facing; the public overview is README.md)
EXPERIMENT.md

# Internal cross-tier ops runbook (shared-infra gates / admin sign-off / billing
# notes); the reusable probe + brain LOGIC is the committed cross-tier/*.py.
cross-tier/PROBE.md

# HPC runner: the real site config is gitignored; site.example.env is committed.
hpc/site.env

# Edge testbed: the real topology is gitignored; testbed.example.yaml is committed.
edge/testbed.yaml

# Cross-tier probe: real host targets gitignored; site.example.env is committed.
cross-tier/site.env

# Vendored kafka-python for offline remote deploy (kafka-python is in requirements.txt)
cross-tier/vendor/
